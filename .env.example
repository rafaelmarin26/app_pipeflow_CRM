# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose in a Client Component or a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=
# price_... of the Pro plan
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# Resend — API Keys
RESEND_API_KEY=

# http://localhost:3000 in development
NEXT_PUBLIC_APP_URL=
